      }
    },
    {
      "id": "heldout-nietzsche-10",
      "split": "held_out",
      "corpus_id": "nietzsche",
      "work_id": "JGB",
      "variant_id": "",
      "segment_id": "p-0060",
      "sentence_id": "p-0060.s001",
      "source_text": "Das, was an der Religiosität der alten Griechen staunen macht, ist die unbändige Fülle von Dankbarkeit, welche sie ausströmt:",
      "source_text_sha256": "9f2049cf8492e2f639e229c35a1bf5341e89edd6d03ce58ad337b5abe8de49d6",
      "policy_exposure": "work_policy",
