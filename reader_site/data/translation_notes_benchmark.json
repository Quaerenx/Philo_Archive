      "work_id": "fb",
      "variant_id": "text",
      "segment_id": "sks-0014",
      "sentence_id": "sks-0014.s001",
      "source_text": "men den, der stred med Gud , blev større end Alle.",
      "source_text_sha256": "cecdb21e741cdf2d31ec3b52d9461bf388078838e016bde7675a23e16ddf71c0",
      "policy_exposure": "none",
      "historical_reference": "",
