      "corpus_id": "kierkegaard",
      "work_id": "ba",
      "variant_id": "text",
      "segment_id": "sks-0034",
      "sentence_id": "sks-0034.s001",
      "source_text": "Denne Modsigelse er den eneste dialektisk consequente, der baade magter Springet og Immanentsen ( ɔ:",
      "source_text_sha256": "7acbdaae101a2278c57adaca0e1388339ee3b5f9eea3862d845da724d6b279ef",
      "policy_exposure": "work_policy",
      "historical_reference": "",
