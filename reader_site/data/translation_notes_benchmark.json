      "corpus_id": "nietzsche",
      "work_id": "FW",
      "variant_id": "",
      "segment_id": "p-0186",
      "sentence_id": "p-0186.s001",
      "source_text": "Im Schweisse unsres Angesichts",
      "source_text_sha256": "ce7a6d25087c6b8bef0d8acb5d133eda58aa4c6398976a7358a03e998f65b9fb",
      "policy_exposure": "none",
