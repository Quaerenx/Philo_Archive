      "work_id": "GM",
      "variant_id": "",
      "segment_id": "p-0016",
      "sentence_id": "p-0016.s002",
      "source_text": "ganz abgesehen von der historischen Unhaltbarkeit jener Hypothese über die Herkunft des Werthurtheils „gut“, krankt sie an einem psychologischen Widersinn in sich selbst.",
      "source_text_sha256": "3f47b2a80b2db5dd25f2299ca7528878d85881252e7800254ad50f66b0ce11f7",
      "policy_exposure": "work_policy",
