        "scores": {},
        "evaluator": ""
      }
    },
    {
      "id": "heldout-nietzsche-09",
      "split": "held_out",
      "corpus_id": "nietzsche",
      "work_id": "MA-I",
      "variant_id": "",
      "segment_id": "p-0057",
      "sentence_id": "p-0057.s002",
      "source_text": "— Wie es sich nun mit Rechnung und Gegenrechnung verhalte:",
      "source_text_sha256": "d40cd977d84cfed5555361d76db3615d93a4506e0f199ded70cd8e7c43bc06a2",
      "policy_exposure": "none",
      "historical_reference": "",
