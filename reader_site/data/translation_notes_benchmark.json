      "corpus_id": "nietzsche",
      "work_id": "JGB",
      "variant_id": "",
      "segment_id": "p-0033",
      "sentence_id": "p-0033.s001",
      "source_text": "Man vergebe es mir als einem alten Philologen, der von der Bosheit nicht lassen kann, auf schlechte Interpretations-Künste den Finger zu legen:",
      "source_text_sha256": "5b3aa8a39cf3c5cc2df96043c24d41f30ba3a1ce303c42b2233291d64e7f59ca",
      "policy_exposure": "work_policy",
