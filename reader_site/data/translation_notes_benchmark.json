        "scores": {},
        "evaluator": ""
      }
    },
    {
      "id": "heldout-kierkegaard-13",
      "split": "held_out",
      "corpus_id": "kierkegaard",
      "work_id": "2t43",
      "variant_id": "text",
      "segment_id": "sks-0011",
      "sentence_id": "sks-0011.s001",
      "source_text": "Et Menneske kan gjøre Meget for et andet, men give ham Troen kan det ikke.",
      "source_text_sha256": "a8b0100a12d820a84dc76bde3a2231cfa30afe7129eefbbaced087ec75f62809",
      "policy_exposure": "none",
