      }
    },
    {
      "id": "heldout-kierkegaard-09",
      "split": "held_out",
      "corpus_id": "kierkegaard",
      "work_id": "2t43",
      "variant_id": "text",
      "segment_id": "sks-0006",
      "sentence_id": "sks-0006.s001",
      "source_text": "et Ønske, der ikke angik det Nærværende, men passede for det Tilkommende, saaledes som dette jo var Anledningen til at han ønskede.",
      "source_text_sha256": "edacb6ba0f3744fa14022913d50da2186f33b0d19bde2a3561c746ede9857b5e",
      "policy_exposure": "none",
      "historical_reference": "",
