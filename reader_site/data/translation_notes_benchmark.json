      "split": "held_out",
      "corpus_id": "nietzsche",
      "work_id": "FW",
      "variant_id": "",
      "segment_id": "p-0089",
      "sentence_id": "p-0089.s001",
      "source_text": "Zum Platzen schon ein kleiner Stich.",
      "source_text_sha256": "97e276165e729f8c83872eb678d643eb92694296021beadfd193ef5e6a7e6f29",
      "policy_exposure": "none",
