        "scores": {},
        "evaluator": ""
      }
    },
    {
      "id": "heldout-kierkegaard-12",
      "split": "held_out",
      "corpus_id": "kierkegaard",
      "work_id": "fb",
      "variant_id": "text",
      "segment_id": "sks-0027",
      "sentence_id": "sks-0027.s001",
      "source_text": "thi mod Penge har jeg ingen ethisk Forpligtelse, men mod Sønnen har Faderen den høieste og helligste.",
      "source_text_sha256": "5dca1c4f46b6034bb53dd5d7862e3823615f7c084b19e50c61e551a3a1a2429e",
      "policy_exposure": "none",
      "historical_reference": "",
