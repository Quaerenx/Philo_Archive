      "corpus_id": "nietzsche",
      "work_id": "GM",
      "variant_id": "",
      "segment_id": "p-0008",
      "sentence_id": "p-0008.s001",
      "source_text": "Im Grunde lag mir gerade damals etwas viel Wichtigeres am Herzen als eignes oder fremdes Hypothesenwesen über den Ursprung der Moral (oder, genauer:",
      "source_text_sha256": "743e1e9d5e4c37a4cd13cf017daaacd0ca0843a9ba5e6ce88eb45f34034abdd3",
      "policy_exposure": "work_policy",
      "historical_reference": "",
