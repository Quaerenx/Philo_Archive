      }
    },
    {
      "id": "heldout-kierkegaard-07",
      "split": "held_out",
      "corpus_id": "kierkegaard",
      "work_id": "ba",
      "variant_id": "text",
      "segment_id": "sks-0017",
      "sentence_id": "sks-0017.s001",
      "source_text": "det vil sige hæver Vanskeligheden, dog ikke ved Ethikens Hjælp, men ved Dogmatikens.",
      "source_text_sha256": "996c712c5eb3e1621ac3a3a0e01e5f6e2f317f65c13418a8144b07c8d2c27f38",
      "policy_exposure": "work_policy",
