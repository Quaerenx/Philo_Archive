      "work_id": "sd",
      "variant_id": "text",
      "segment_id": "sks-0015",
      "sentence_id": "sks-0015.s001",
      "source_text": "Skulde et Menneske døe af Fortvivlelse, som man døer af en Sygdom, saa maatte det Evige i ham, Selvet, kunne døe i samme Forstand som Legemet døer af Sygdommen.",
      "source_text_sha256": "cff5e432fb623c94390d263e1d71e3b4425098076e3be8972acf7709336d7336",
      "policy_exposure": "none",
