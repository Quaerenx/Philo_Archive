      "work_id": "Group_ItemsInEnglish",
      "variant_id": "idp_transcription_linear",
      "segment_id": "p-0080",
      "sentence_id": "p-0080.s001",
      "source_text": "What happens in it is that all its simple parts have meaning, but it is such that the connections between these paralyse or destroy one another, so that they are all connected only in an irrelevant manner.",
      "source_text_sha256": "afbe2f2d38d167a84e7435411676a3c99b6e74db1c736e6cf486f70248d8ab65",
